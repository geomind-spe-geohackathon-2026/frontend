# Copy to .env: production and local development read the same file and the same names.
# The backend's /api/v1 address (the frontend's nginx does not proxy the API).
VITE_API_URL=https://api.geomind.team/api/v1
# Development server only: mock or real. A production build always uses the real API.
VITE_API_MODE=
# "true" shows the Operation pages in the sidebar.
VITE_FEATURE_OPERATION=
